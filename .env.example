# Environment Variables Template
# Copy this file to .env.local and replace the placeholder values

# Resend API Key for email functionality
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
# Optional: GitHub token for reading project data from repos (lib/github-projects.ts).
# Needed for private repos and raises the API rate limit. A fine-grained token with
# read-only "Contents" and "Metadata" access to the listed repos is enough.
GITHUB_TOKEN=your_github_token_here
